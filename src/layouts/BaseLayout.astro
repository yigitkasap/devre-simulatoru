---
// Tüm sayfaların ortak iskeleti. İleride eklenecek içerik sayfaları (birimler, dönüşümler,
// formüller) da bu düzeni kullanır.
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_NAME } from '../config';
// Yazı tipleri src/assets/fonts'ta: Vite hem geliştirmede hem derlemede doğru yolu (base dahil) verir.
// Lisans (OFL) public/fonts/OFL.txt olarak siteyle birlikte yayımlanır.
import plexSans from '../assets/fonts/plex-sans-var-latin.woff2?url';

interface Props {
  /** Sayfa başlığı; verilmezse yalnızca site adı kullanılır. */
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
// Site bir alt klasörde yayımlanırsa (astro.config.mjs → base) yollar ona göre kurulur.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef0f3" />
    <script is:inline>
      // Renk teması React'ten önce uygulanır (açılışta açık temadan koyuya yanıp sönmesin). Kayıt:
      // src/editor/settings.ts (theme: system | light | dark); uygulama: src/editor/theme.ts.
      (function () {
        var choice = 'system';
        try {
          choice = JSON.parse(localStorage.getItem('devre-simulatoru:ayarlar') || '{}').theme || 'system';
        } catch (e) {}
        var dark = choice === 'dark' || (choice !== 'light' && window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches);
        var root = document.documentElement;
        root.dataset.theme = dark ? 'dark' : 'light';
        root.style.colorScheme = dark ? 'dark' : 'light';
        if (dark) document.querySelector('meta[name="theme-color"]').setAttribute('content', '#0e1318');
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preload" href={plexSans} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
